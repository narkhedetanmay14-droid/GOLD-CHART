# BiQuote API Configuration (Public read endpoints do not require API keys)
BIQUOTE_BASE_URL=https://biquote.io/api
BIQUOTE_HUB_URL=https://biquote.io/hubs/tick

# Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Trading System Settings
SYMBOL=XAUUSD
CONFIDENCE_THRESHOLD=90.0
EFFICIENCY_THRESHOLD=90.0
RISK_REWARD_RATIO=2.0
LIMIT_EXPIRY_SECONDS=180
